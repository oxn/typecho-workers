    "warm",
    "minimal",
    "notes",
    "single-column"
  ],
  "config": {
    "cyServiceUi": {
      "type": "text",
      "label": "",
      "description": "<style>/* CY 服务插件设置页：样式仅作用于本插件容器，不依赖主题 CSS。 */\n.cy-service-settings {\n  box-sizing: border-box;\n  width: 66.6667%;\n  margin-left: 16.6667%;\n  padding-top: 4px;\n  color: #34433a;\n  font-size: 14px;\n  line-height: 1.6;\n}\n.cy-service-settings *,\n.cy-service-settings *::before,\n.cy-service-settings *::after {\n  box-sizing: border-box;\n}\n.cy-service-header {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin: 0 0 18px;\n}\n.cy-service-header > strong {\n  color: #26352d;\n  font-size: 16px;\n  font-weight: 700;\n}\n.cy-service-version {\n  color: #77817b;\n  font-size: 13px;\n}\n.cy-service-header > a {\n  display: inline-flex;\n  align-items: center;\n  padding: 7px 12px;\n  border: 1px solid #dce4df;\n  border-radius: 7px;\n  background: #fff;\n  color: #269b63;\n  text-decoration: none;\n  font-size: 13px;\n}\n.cy-service-header > a:hover {\n  border-color: #269b63;\n  background: #f5fbf7;\n}\n.cy-service-card {\n  margin: 0 0 16px;\n  padding: 16px 18px;\n  border: 1px solid #e5e9e7;\n  border-radius: 9px;\n  background: #fff;\n  box-shadow: 0 2px 9px rgba(20, 40, 30, .035);\n}\n\n.cy-service-top-actions-card .cy-service-links-heading {\n  margin-bottom: 10px;\n  padding-bottom: 0;\n  border-bottom: 0;\n}\n\n.cy-service-top-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 24px;\n}\n.cy-service-top-action {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: #56635b;\n  font-size: 13px;\n  cursor: pointer;\n}\n.cy-service-top-action input {\n  width: 15px;\n  height: 15px;\n  margin: 0;\n  accent-color: #269b63;\n}\n\n.cy-service-field-head {\n  margin: 0 0 9px;\n}\n.cy-service-field-head > label {\n  display: block;\n  margin: 0 0 5px;\n  color: #26352d;\n  font-size: 14px;\n  font-weight: 650;\n  line-height: 1.6;\n}\n.cy-service-description {\n  margin: 0;\n  color: #77817b;\n  font-size: 12px;\n  line-height: 1.7;\n}\n.cy-service-description strong {\n  color: #46534b;\n  font-weight: 600;\n}\n.cy-service-description code {\n  padding: 1px 4px;\n  border-radius: 3px;\n  background: #f3f6f4;\n  color: #46534b;\n  font-size: 12px;\n}\n.cy-service-settings input[type=\"text\"],\n.cy-service-settings textarea {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  min-height: 34px;\n  padding: 6px 9px;\n  border: 1px solid #dce4df;\n  border-radius: 6px;\n  background: #fff;\n  color: #34433a;\n  font: inherit;\n  line-height: 1.6;\n  box-shadow: none;\n}\n.cy-service-settings textarea {\n  min-height: 150px;\n  resize: vertical;\n}\n.cy-service-settings input:focus,\n.cy-service-settings textarea:focus {\n  border-color: #269b63;\n  outline: 1px solid rgba(38, 155, 99, .16);\n  box-shadow: 0 0 0 2px rgba(38, 155, 99, .08);\n}\n.cy-service-links-group {\n  margin: 0 0 22px;\n  padding: 16px 18px 8px;\n  border: 1px solid #e5e9e7;\n  border-radius: 9px;\n  background: #fff;\n}\n.cy-service-links-heading {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 8px 14px;\n  margin: 0 0 12px;\n  padding: 0 0 11px;\n  border-bottom: 1px solid #dfe6e1;\n  text-align: left;\n}\n.cy-service-links-heading strong {\n  color: #26352d;\n  font-size: 15px;\n  font-weight: 650;\n}\n.cy-service-links-heading span {\n  color: #77817b;\n  font-size: 12px;\n  line-height: 1.6;\n}\n.cy-service-link-row {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 12px 0 14px;\n  border-bottom: 1px solid #e8ece9;\n}\n.cy-service-link-row:last-child {\n  border-bottom: 0;\n}\n.cy-service-link-text-line,\n.cy-service-link-url-line {\n  display: flex;\n  flex-wrap: nowrap;\n  align-items: center;\n  gap: 9px;\n  min-width: 0;\n}\n.cy-service-link-text-line > label:first-child,\n.cy-service-link-url-line > label {\n  flex: 0 0 62px;\n  color: #46534b;\n  font-size: 13px;\n  text-align: left;\n}\n.cy-service-link-text-line > input,\n.cy-service-link-url-line > input {\n  flex: 1 1 auto;\n  width: 1%;\n}\n.cy-service-new-window {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  gap: 6px;\n  color: #56635b;\n  font-size: 12px;\n  white-space: nowrap;\n  cursor: pointer;\n}\n.cy-service-new-window input {\n  width: 15px;\n  height: 15px;\n  margin: 0;\n  accent-color: #269b63;\n}\n@media (max-width: 767px) {\n  .cy-service-settings {\n    width: 100%;\n    margin-left: 0;\n  }\n}\n@media (max-width: 640px) {\n  .cy-service-card {\n    padding: 14px;\n  }\n  .cy-service-links-group {\n    padding: 14px 14px 6px;\n  }\n  .cy-service-links-heading {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 3px;\n  }\n  .cy-service-link-text-line,\n  .cy-service-link-url-line {\n    flex-wrap: nowrap;\n  }\n  .cy-service-link-text-line > label:first-child,\n  .cy-service-link-url-line > label {\n    flex-basis: 54px;\n  }\n}\n\n/* CY 容器保持原插件页面的 2/3 居中宽度；外层设置项扩展到完整内容宽度 */\n#typecho-option-item-cyServiceUi-0 {\n  width: 150%;\n  margin-left: -25%;\n}\n#typecho-option-item-cyServiceUi-0 > li > .typecho-label,\n#typecho-option-item-cyServiceUi-0 > li > input.text {\n  display: none !important;\n}\n#typecho-option-item-cyServiceUi-0 > li > .description {\n  display: block;\n  margin: 0;\n  padding: 0;\n}\n/* 自定义导航按键：标题分隔与标签、输入框同行，窄屏保持同行 */\n.cy-service-nav-labels {\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top: 1px solid #dfe6e1;\n}\n.cy-service-nav-field {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  margin: 0 0 10px;\n}\n.cy-service-nav-field > label {\n  flex: 0 0 54px;\n  margin: 0;\n  color: #46534b;\n  font-size: 13px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n.cy-service-nav-field > input {\n  flex: 1 1 auto;\n  width: 1%;\n  min-width: 0;\n}\n/* OXN 原有设置全部放在 CY 区域之后，每项独立卡片 */\n#typecho-option-item-imageOptimizeParams-34,\n#typecho-option-item-thumbOptimizeParams-35,\n#typecho-option-item-continuousLoadMode-36,\n#typecho-option-item-commentComponentLoadMode-37,\n#typecho-option-item-commentInitialLoadMode-38 {\n  margin: 0 0 14px !important;\n  padding: 15px 18px !important;\n  border: 1px solid #e5e9e7 !important;\n  border-radius: 9px !important;\n  background: #fff !important;\n  box-shadow: 0 2px 9px rgba(20, 40, 30, .035) !important;\n}\n#typecho-option-item-imageOptimizeParams-34 > li,\n#typecho-option-item-thumbOptimizeParams-35 > li,\n#typecho-option-item-continuousLoadMode-36 > li,\n#typecho-option-item-commentComponentLoadMode-37 > li,\n#typecho-option-item-commentInitialLoadMode-38 > li {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  align-items: baseline;\n  column-gap: 14px;\n  row-gap: 9px;\n}\n#typecho-option-item-imageOptimizeParams-34 .typecho-label,\n#typecho-option-item-thumbOptimizeParams-35 .typecho-label,\n#typecho-option-item-continuousLoadMode-36 .typecho-label,\n#typecho-option-item-commentComponentLoadMode-37 .typecho-label,\n#typecho-option-item-commentInitialLoadMode-38 .typecho-label {\n  grid-column: 1;\n  grid-row: 1;\n  margin: 0;\n  color: #26352d;\n  font-size: 14px;\n  font-weight: 650;\n  line-height: 1.6;\n}\n#typecho-option-item-imageOptimizeParams-34 .description,\n#typecho-option-item-thumbOptimizeParams-35 .description,\n#typecho-option-item-continuousLoadMode-36 .description,\n#typecho-option-item-commentComponentLoadMode-37 .description,\n#typecho-option-item-commentInitialLoadMode-38 .description {\n  grid-column: 2;\n  grid-row: 1;\n  margin: 0;\n  color: #77817b;\n  font-size: 12px;\n  line-height: 1.7;\n}\n#typecho-option-item-imageOptimizeParams-34 input.text,\n#typecho-option-item-thumbOptimizeParams-35 input.text,\n#typecho-option-item-continuousLoadMode-36 select,\n#typecho-option-item-commentComponentLoadMode-37 select,\n#typecho-option-item-commentInitialLoadMode-38 select {\n  grid-column: 1 / -1;\n  grid-row: 2;\n  width: 100%;\n  max-width: 100%;\n  box-sizing: border-box;\n}\n@media (max-width: 767px) {\n  #typecho-option-item-cyServiceUi-0 {\n    width: 100%;\n    margin-left: 0;\n  }\n  #typecho-option-item-imageOptimizeParams-34,\n  #typecho-option-item-thumbOptimizeParams-35,\n  #typecho-option-item-continuousLoadMode-36,\n  #typecho-option-item-commentComponentLoadMode-37,\n  #typecho-option-item-commentInitialLoadMode-38 {\n    padding: 14px !important;\n  }\n  #typecho-option-item-imageOptimizeParams-34 > li,\n  #typecho-option-item-thumbOptimizeParams-35 > li,\n  #typecho-option-item-continuousLoadMode-36 > li,\n  #typecho-option-item-commentComponentLoadMode-37 > li,\n  #typecho-option-item-commentInitialLoadMode-38 > li {\n    grid-template-columns: minmax(0, 1fr);\n    row-gap: 5px;\n  }\n  #typecho-option-item-imageOptimizeParams-34 .typecho-label,\n  #typecho-option-item-thumbOptimizeParams-35 .typecho-label,\n  #typecho-option-item-continuousLoadMode-36 .typecho-label,\n  #typecho-option-item-commentComponentLoadMode-37 .typecho-label,\n  #typecho-option-item-commentInitialLoadMode-38 .typecho-label,\n  #typecho-option-item-imageOptimizeParams-34 .description,\n  #typecho-option-item-thumbOptimizeParams-35 .description,\n  #typecho-option-item-continuousLoadMode-36 .description,\n  #typecho-option-item-commentComponentLoadMode-37 .description,\n  #typecho-option-item-commentInitialLoadMode-38 .description {\n    grid-column: 1;\n    grid-row: auto;\n  }\n}\n  .oxn-settings-actions {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  .oxn-settings-tools {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-left: auto;\n  }\n\n  .oxn-settings-icon {\n    width: 16px;\n    height: 16px;\n    margin-right: 4px;\n    color: #999;\n    vertical-align: -3px;\n  }\n\n  @media (max-width: 480px) {\n    .oxn-settings-tools {\n      margin-left: 0;\n    }\n  }\n\n\n.oxn-pin-actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 12px;\n}\n#oxn-pin-save-status {\n  color: #77817b;\n  font-size: 12px;\n  line-height: 1.6;\n}\n#oxn-pin-save-status[data-state=\"success\"] {\n  color: #269b63;\n}\n#oxn-pin-save-status[data-state=\"error\"] {\n  color: #c43d3d;\n}\n</style>\n<div class=\"cy-service-settings\" data-cy-oxn-settings>\n  <main class=\"cy-service-form\">\n    \n    <section class=\"cy-service-card cy-service-home-card\">\n      <div class=\"cy-service-field-head\">\n        <label for=\"cy-pinned-ids\">首页置顶文章 ID</label>\n        <p class=\"cy-service-description\">只控制首页置顶。填写文章 ID，多个 ID 用英文逗号分隔；其他页面不受影响。</p>\n      </div>\n      <input id=\"cy-pinned-ids\" type=\"text\">\n      <div class=\"oxn-pin-actions\">\n        <button type=\"button\" class=\"btn primary\" id=\"oxn-save-pinned-ids\">保存置顶 CID</button>\n        <span id=\"oxn-pin-save-status\" role=\"status\" aria-live=\"polite\"></span>\n      </div>\n    </section>\n    <section class=\"cy-service-card cy-service-top-actions-card\">\n      <div class=\"cy-service-links-heading\">\n        <strong>主题功能按键</strong>\n      </div>\n      <div class=\"cy-service-top-actions\">\n        <label class=\"cy-service-top-action\" for=\"cy-theme-toggle-button\">\n          <input id=\"cy-theme-toggle-button\" data-cy-key=\"showThemeToggleButton\" type=\"checkbox\">\n          <span>明暗切换</span>\n        </label>\n        <label class=\"cy-service-top-action\" for=\"cy-search-button\">\n          <input id=\"cy-search-button\" data-cy-key=\"showHomeSearchButton\" type=\"checkbox\">\n          <span>搜索按键</span>\n        </label>\n        <label class=\"cy-service-top-action\" for=\"cy-admin-entry-button\">\n          <input id=\"cy-admin-entry-button\" data-cy-key=\"showAdminEntryButton\" type=\"checkbox\">\n          <span>登录按键</span>\n        </label>\n        <label class=\"cy-service-top-action\" for=\"cy-comment-management-button\">\n          <input id=\"cy-comment-management-button\" data-cy-key=\"showCommentManagementButtons\" type=\"checkbox\">\n          <span>评论区管理按键</span>\n        </label>\n      </div>\n      <p class=\"cy-service-description\">控制文章和独立页面评论区是否显示管理员操作按键。关闭后只隐藏前台按键，不影响后台管理权限及管理接口。</p>\n      <div class=\"cy-service-nav-labels\">\n        <div class=\"cy-service-links-heading\">\n          <strong>自定义导航按键</strong>\n          <span>格式参照下方「页脚文字」支持的格式。</span>\n        </div>\n        <div class=\"cy-service-nav-field\">\n          <label for=\"cy-nav-home-label\">首页</label>\n          <input id=\"cy-nav-home-label\" data-cy-key=\"navHomeLabel\" type=\"text\" placeholder=\"默认：首页\">\n        </div>\n        <div class=\"cy-service-nav-field\">\n          <label for=\"cy-nav-articles-label\">文章</label>\n          <input id=\"cy-nav-articles-label\" data-cy-key=\"navArticlesLabel\" type=\"text\" placeholder=\"默认：文章\">\n        </div>\n        <div class=\"cy-service-nav-field\">\n          <label for=\"cy-nav-notes-label\">笔记</label>\n          <input id=\"cy-nav-notes-label\" data-cy-key=\"navNotesLabel\" type=\"text\" placeholder=\"默认：笔记\">\n        </div>\n      </div>\n    </section>\n    <section class=\"cy-service-links-group\">\n      <div class=\"cy-service-links-heading\">\n        <strong>页脚连接</strong>\n        <span>支持 https://、http://、mailto:、站内链接；普通域名可直接填写。</span>\n      </div>\n      <p class=\"cy-service-description\">\n        <strong>页脚文字：</strong>支持普通文字、完整 HTML、SVG 源码，以及 HTML、SVG 与文字混合输入。也支持 Octicons 集中格式：<code>{{octicon:mark-github}}</code> 或 <code>{{icons:mark-github}}</code>；标记放在文字开头，后面可以继续填写文字。还支持带提示文字的包裹格式，例如 <code>&lt;span title=&quot;提示文字&quot;&gt;文字或 SVG&lt;/span&gt;</code>。HTML/SVG 会按原始片段输出，请确保标签完整闭合，只粘贴可信内容。 <a href=\"https://primer.style/octicons/\" target=\"_blank\" rel=\"noopener noreferrer\">查询 Octicons 图标库</a>\n      </p>\n      <div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-01\">文字1：</label>\n    <input id=\"cy-link-text-01\" data-cy-key=\"linktxt01\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-01\">网址1：</label>\n    <input id=\"cy-link-url-01\" data-cy-key=\"links01\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-01\">\n      <input id=\"cy-link-blank-01\" data-cy-key=\"linkblank01\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-02\">文字2：</label>\n    <input id=\"cy-link-text-02\" data-cy-key=\"linktxt02\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-02\">网址2：</label>\n    <input id=\"cy-link-url-02\" data-cy-key=\"links02\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-02\">\n      <input id=\"cy-link-blank-02\" data-cy-key=\"linkblank02\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-03\">文字3：</label>\n    <input id=\"cy-link-text-03\" data-cy-key=\"linktxt03\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-03\">网址3：</label>\n    <input id=\"cy-link-url-03\" data-cy-key=\"links03\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-03\">\n      <input id=\"cy-link-blank-03\" data-cy-key=\"linkblank03\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-04\">文字4：</label>\n    <input id=\"cy-link-text-04\" data-cy-key=\"linktxt04\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-04\">网址4：</label>\n    <input id=\"cy-link-url-04\" data-cy-key=\"links04\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-04\">\n      <input id=\"cy-link-blank-04\" data-cy-key=\"linkblank04\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-05\">文字5：</label>\n    <input id=\"cy-link-text-05\" data-cy-key=\"linktxt05\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-05\">网址5：</label>\n    <input id=\"cy-link-url-05\" data-cy-key=\"links05\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-05\">\n      <input id=\"cy-link-blank-05\" data-cy-key=\"linkblank05\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-06\">文字6：</label>\n    <input id=\"cy-link-text-06\" data-cy-key=\"linktxt06\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-06\">网址6：</label>\n    <input id=\"cy-link-url-06\" data-cy-key=\"links06\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-06\">\n      <input id=\"cy-link-blank-06\" data-cy-key=\"linkblank06\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-07\">文字7：</label>\n    <input id=\"cy-link-text-07\" data-cy-key=\"linktxt07\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-07\">网址7：</label>\n    <input id=\"cy-link-url-07\" data-cy-key=\"links07\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-07\">\n      <input id=\"cy-link-blank-07\" data-cy-key=\"linkblank07\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-08\">文字8：</label>\n    <input id=\"cy-link-text-08\" data-cy-key=\"linktxt08\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-08\">网址8：</label>\n    <input id=\"cy-link-url-08\" data-cy-key=\"links08\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-08\">\n      <input id=\"cy-link-blank-08\" data-cy-key=\"linkblank08\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-09\">文字9：</label>\n    <input id=\"cy-link-text-09\" data-cy-key=\"linktxt09\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-09\">网址9：</label>\n    <input id=\"cy-link-url-09\" data-cy-key=\"links09\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-09\">\n      <input id=\"cy-link-blank-09\" data-cy-key=\"linkblank09\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n<div class=\"cy-service-link-row\">\n  <div class=\"cy-service-link-text-line\">\n    <label for=\"cy-link-text-10\">文字10：</label>\n    <input id=\"cy-link-text-10\" data-cy-key=\"linktxt10\" type=\"text\">\n  </div>\n  <div class=\"cy-service-link-url-line\">\n    <label for=\"cy-link-url-10\">网址10：</label>\n    <input id=\"cy-link-url-10\" data-cy-key=\"links10\" type=\"text\">\n    <label class=\"cy-service-new-window\" for=\"cy-link-blank-10\">\n      <input id=\"cy-link-blank-10\" data-cy-key=\"linkblank10\" type=\"checkbox\">\n      <span>新窗口</span>\n    </label>\n  </div>\n</div>\n    </section>\n    <section class=\"cy-service-card cy-service-article-card\">\n      <div class=\"cy-service-field-head\">\n        <label for=\"cy-article-declaration\">文章内容声明</label>\n        <p class=\"cy-service-description\">\n          仅在文章详情页显示，位于正文末尾、评论区之前；笔记页不显示。留空则不显示。支持 HTML。<br>\n          <strong>变量说明：</strong><code>{site.name}</code>：网站名称；<code>{site.url}</code>：网站首页地址；<code>{site.description}</code>：网站简介。<br>\n          <code>{post.title}</code>：当前文章标题；<code>{post.url}</code>：当前文章完整访问地址。<br>\n          <strong>样式说明：</strong>声明内 CSS 仅作用于声明区块。需要边框、背景、圆角或内边距时，可自行在 HTML/CSS 中定义。变量替换值会进行 HTML 转义。\n        </p>\n      </div>\n      <textarea id=\"cy-article-declaration\" data-cy-key=\"articleDeclarationHtml\"></textarea>\n    </section>\n    <section class=\"cy-service-card cy-service-footer-card\">\n      <div class=\"cy-service-field-head\">\n        <label for=\"cy-footer-content\">站点底部内容</label>\n        <p class=\"cy-service-description\">设置显示于站点底部的内容（HTML）</p>\n      </div>\n      <textarea id=\"cy-footer-content\" data-cy-key=\"footerCustomHtml\"></textarea>\n    </section>\n  </main>\n</div>\n<script>\n(function () {\n  function initCySettings() {\n    var root = document.querySelector('[data-cy-oxn-settings]');\n    if (!root || root.dataset.initialized === '1') return;\n    root.dataset.initialized = '1';\n    var form = root.closest('form');\n    var pinnedInput = root.querySelector('#cy-pinned-ids');\n    var pinSaveButton = root.querySelector('#oxn-save-pinned-ids');\n    var pinSaveStatus = root.querySelector('#oxn-pin-save-status');\n\n    function setPinStatus(message, state) {\n      if (!pinSaveStatus) return;\n      pinSaveStatus.textContent = message;\n      pinSaveStatus.dataset.state = state || '';\n    }\n\n    // 置顶 CID 独立读写专用 option，不参与主题设置表单的同步和提交。\n    if (pinnedInput && pinSaveButton) {\n      fetch('/api/admin/theme-pin?list=1', { credentials: 'same-origin' })\n        .then(function (response) {\n          return response.json().then(function (data) {\n            if (!response.ok) throw new Error(data.error || '读取置顶 CID 失败');\n            return data;\n          });\n        })\n        .then(function (data) {\n          if (Array.isArray(data.pinnedIds)) {\n            pinnedInput.value = data.pinnedIds.join(', ');\n            setPinStatus('已从数据库读取当前置顶列表');\n          }\n        })\n        .catch(function (error) {\n          setPinStatus(error instanceof Error ? error.message : '读取置顶 CID 失败', 'error');\n        });\n\n      pinSaveButton.addEventListener('click', async function () {\n        var csrfInput = form && form.querySelector('input[name=\"_\"]');\n        var csrfToken = csrfInput ? csrfInput.value : '';\n        if (!csrfToken) {\n          setPinStatus('未找到安全验证令牌，请刷新页面后重试', 'error');\n          return;\n        }\n\n        pinSaveButton.disabled = true;\n        setPinStatus('正在保存并验证数据库记录…');\n        try {\n          var response = await fetch('/api/admin/theme-pin', {\n            method: 'POST',\n            credentials: 'same-origin',\n            headers: {\n              'Content-Type': 'application/json',\n              'X-CSRF-Token': csrfToken\n            },\n            body: JSON.stringify({\n              action: 'replace',\n              pinnedIds: pinnedInput.value\n            })\n          });\n          var result = await response.json();\n          if (!response.ok || result.success !== true) {\n            throw new Error(result.error || '保存置顶 CID 失败');\n          }\n          pinnedInput.value = Array.isArray(result.pinnedIds) ? result.pinnedIds.join(', ') : '';\n          setPinStatus('保存成功，数据库已确认 ' + (result.pinnedIds || []).length + ' 个置顶 CID', 'success');\n        } catch (error) {\n          setPinStatus(error instanceof Error ? error.message : '保存置顶 CID 失败', 'error');\n        } finally {\n          pinSaveButton.disabled = false;\n        }\n      });\n    }\n\n    function findStored(key) {\n      if (!form) return null;\n      return Array.from(form.querySelectorAll('input[type=\"hidden\"]')).find(function (input) {\n        return input.name === key || input.name.endsWith('[' + key + ']');\n      }) || null;\n    }\n    function sync() {\n      root.querySelectorAll('[data-cy-key]').forEach(function (control) {\n        var stored = findStored(control.getAttribute('data-cy-key'));\n        if (!stored) return;\n        stored.value = control.type === 'checkbox' ? (control.checked ? '1' : '0') : control.value;\n      });\n    }\n    root.querySelectorAll('[data-cy-key]').forEach(function (control) {\n      var stored = findStored(control.getAttribute('data-cy-key'));\n      if (!stored) return;\n      if (control.type === 'checkbox') control.checked = stored.value === '1' || stored.value === 'true';\n      else control.value = stored.value || '';\n      control.addEventListener('input', sync);\n      control.addEventListener('change', sync);\n    });\n    if (form) form.addEventListener('submit', function () {\n      sync();\n    });\n\n    // OXN theme settings backup controls. Import/export operate on the current page form only.\n    var submitRow = form && form.querySelector('.typecho-option-submit li');\n    if (submitRow && !document.getElementById('oxn-export-settings')) {\n      submitRow.classList.add('oxn-settings-actions');\n      var tools = document.createElement('div');\n      tools.className = 'oxn-settings-tools';\n      tools.innerHTML =\n        '<button type=\"button\" class=\"btn primary\" id=\"oxn-export-settings\">' +\n          '<svg class=\"oxn-settings-icon\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\">' +\n            '<path d=\"M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z\"/><path d=\"M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z\"/>' +\n          '</svg>导出设置</button>' +\n        '<button type=\"button\" class=\"btn primary\" id=\"oxn-import-settings\">' +\n          '<svg class=\"oxn-settings-icon\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\">' +\n            '<path d=\"M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z\"/><path d=\"M11.78 4.72a.749.749 0 1 1-1.06 1.06L8.75 3.811V9.5a.75.75 0 0 1-1.5 0V3.811L5.28 5.78a.749.749 0 1 1-1.06-1.06l3.25-3.25a.749.749 0 0 1 1.06 0l3.25 3.25Z\"/>' +\n          '</svg>导入设置</button>';\n      var importFile = document.createElement('input');\n      importFile.type = 'file';\n      importFile.id = 'oxn-import-file';\n      importFile.accept = 'application/json,.json';\n      importFile.hidden = true;\n      tools.appendChild(importFile);\n      submitRow.appendChild(tools);\n\n      var exportButton = tools.querySelector('#oxn-export-settings');\n      var importButton = tools.querySelector('#oxn-import-settings');\n      exportButton.addEventListener('click', function () {\n        try {\n          // 直接导出当前页面表单，不请求接口、不读取数据库。\n          sync();\n          var settings = {};\n          var elements = Array.from(form.elements);\n          var keys = Array.from(new Set(elements\n            .filter(function (field) {\n              return field.name && field.name !== '_' && field.name !== 'pinnedIds' &&\n                !['button', 'submit', 'reset', 'file'].includes(field.type);\n            })\n            .map(function (field) {\n              return field.name.endsWith('[]') ? field.name.slice(0, -2) : field.name;\n            })));\n\n          keys.forEach(function (key) {\n            var fields = elements.filter(function (field) {\n              return field.name === key || field.name === key + '[]';\n            });\n            if (!fields.length) return;\n\n            if (fields[0].type === 'radio') {\n              var checkedRadio = fields.find(function (field) { return field.checked; });\n              settings[key] = checkedRadio ? checkedRadio.value : '';\n            } else if (fields[0].type === 'checkbox' && fields.some(function (field) { return field.name === key + '[]'; })) {\n              settings[key] = fields.filter(function (field) {\n                return field.name === key + '[]' && field.checked;\n              }).map(function (field) { return field.value; });\n            } else if (fields[0].type === 'checkbox') {\n              settings[key] = fields[0].checked;\n            } else if (fields[0].tagName === 'SELECT' && fields[0].multiple) {\n              settings[key] = Array.from(fields[0].selectedOptions).map(function (option) { return option.value; });\n            } else {\n              settings[key] = fields[0].value;\n            }\n          });\n\n          // 置顶 ID 是页面中的独立表单控件，也纳入备份。\n          settings.pinnedIds = pinnedInput ? pinnedInput.value : '';\n          var backup = {\n            format: 'oxn-theme-config',\n            version: 1,\n            sourceTheme: 'typecho-theme-oxn',\n            settings: settings\n          };\n          var blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });\n          var url = URL.createObjectURL(blob);\n          var link = document.createElement('a');\n          link.href = url;\n          link.download = 'oxn-theme-settings.json';\n          link.click();\n          URL.revokeObjectURL(url);\n        } catch (error) {\n          alert(error instanceof Error ? error.message : '导出设置失败');\n        }\n      });\n\n      importButton.addEventListener('click', function () {\n        importFile.click();\n      });\n\n      importFile.addEventListener('change', async function () {\n        var file = importFile.files && importFile.files[0];\n        if (!file) return;\n        try {\n          var backup = JSON.parse(await file.text());\n          var isCurrentBackup =\n            backup && backup.format === 'oxn-theme-config' &&\n            backup.version === 1 &&\n            typeof backup.sourceTheme === 'string' &&\n            backup.sourceTheme.length > 0;\n          var isLegacyBackup =\n            backup && backup.format === 'oxn-theme-settings' &&\n            backup.version === 1 &&\n            backup.theme === 'typecho-theme-oxn';\n          if (\n            (!isCurrentBackup && !isLegacyBackup) ||\n            !backup.settings ||\n            typeof backup.settings !== 'object' ||\n            Array.isArray(backup.settings)\n          ) {\n            throw new Error('文件格式不正确，无法识别主题设置备份');\n          }\n          if (!confirm('导入设置将覆盖当前 OXN 主题中对应的设置项，是否继续？')) return;\n          Object.keys(backup.settings).forEach(function (key) {\n            var value = backup.settings[key];\n            if (key === 'pinnedIds' && pinnedInput) {\n              pinnedInput.value = Array.isArray(value) ? value.join(', ') : (value == null ? '' : String(value));\n            }\n            var fields = Array.from(form.elements).filter(function (field) {\n              return field.name === key || field.name === key + '[]';\n            });\n            if (!fields.length) return;\n\n            fields.forEach(function (field) {\n              if (field.type === 'radio') {\n                field.checked = String(value) === field.value;\n              } else if (field.type === 'checkbox') {\n                if (field.name === key + '[]') {\n                  field.checked = Array.isArray(value) && value.map(String).includes(field.value);\n                } else {\n                  field.checked = value === true || value === 1 || value === '1' || value === 'true';\n                }\n              } else if (field.tagName === 'SELECT' && field.multiple) {\n                Array.from(field.options).forEach(function (option) {\n                  option.selected = Array.isArray(value) && value.map(String).includes(option.value);\n                });\n              } else {\n                field.value = value == null ? '' : String(value);\n              }\n            });\n          });\n\n          // 同步 OXN 自定义设置的隐藏表单字段到可见控件；不提交、不保存。\n          root.querySelectorAll('[data-cy-key]').forEach(function (control) {\n            var stored = findStored(control.getAttribute('data-cy-key'));\n            if (!stored) return;\n            if (control.type === 'checkbox') {\n              control.checked = stored.value === '1' || stored.value === 'true';\n            } else {\n              control.value = stored.value || '';\n            }\n          });\n          alert('设置已导入当前表单。普通主题设置请点击“保存设置”；置顶 ID 请单独点击“保存置顶 CID”。');\n        } catch (error) {\n          alert(error instanceof Error ? error.message : '导入设置失败');\n        } finally {\n          importFile.value = '';\n        }\n      });\n    }\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCySettings, { once: true });\n  else initCySettings();\n})();\n</script>",
