---
import type { ThemePageProps } from '@/lib/theme-props';
import WarmShell from './WarmShell.astro';
import WarmComments from './WarmComments.astro';
import { optimizeContentImages } from '@/lib/image-transform';
import { plainExcerpt, warmSettings } from './warm';

type Props = ThemePageProps;
const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  page, commentPagination,
} = Astro.props;

const START_MARKER = '[[FRIENDLINKS:START]]';
const END_MARKER = '[[FRIENDLINKS:END]]';

function decodeHtml(value: string): string {
  return value
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .replace(/&nbsp;/gi, ' ')
    .replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
    .replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(parseInt(code, 16)));
}

function htmlToText(value: string): string {
  return decodeHtml(
    value
      .replace(/<br\s*\/?\s*>/gi, '\n')
      .replace(/<[^>]*>/g, '')
  );
}

type FriendLink = { name: string; url: string; description: string };
type FriendLinkContentPart =
  | { type: 'html'; content: string }
  | { type: 'links'; links: FriendLink[] };

function parseFriendLinks(dataHtml: string): FriendLink[] {
  const paragraphs = [...dataHtml.matchAll(/<p\\b[^>]*>([\\s\\S]*?)<\\/p>/gi)];
  const links: FriendLink[] = [];

  for (const paragraph of paragraphs) {
    const text = htmlToText(paragraph[1]).trim();
    if (!text) continue;

    let name = '';
    let rawUrl = '';
    let description = '';
    const lines = text.split(/\\r?\\n/).map(line => line.trim()).filter(Boolean);

    if (lines.length >= 2) {
      name = lines[0];
      rawUrl = lines[1];
      description = lines.slice(2).join(' ');
    } else {
      const match = text.match(/https?:\\/\\/[^\\s<>]+/i);
      if (!match || match.index === undefined) continue;
      name = text.slice(0, match.index).trim();
      rawUrl = match[0].replace(/[),.;!?]+$/, '');
      description = text.slice(match.index + match[0].length).trim();
    }

    try {
      const parsedUrl = new URL(rawUrl);
      if (!name || !['http:', 'https:'].includes(parsedUrl.protocol)) continue;
      links.push({ name, url: parsedUrl.href, description });
    } catch {
      continue;
    }
  }

  return links;
}

function extractFriendLinks(html: string): { content: string; parts: FriendLinkContentPart[] } {
  const contentParts: string[] = [];
  const parts: FriendLinkContentPart[] = [];
  let cursor = 0;

  const appendHtml = (value: string) => {
    if (!value) return;
    contentParts.push(value);
    parts.push({ type: 'html', content: value });
  };

  while (cursor < html.length) {
    const startIndex = html.indexOf(START_MARKER, cursor);
    if (startIndex < 0) break;

    const endIndex = html.indexOf(END_MARKER, startIndex + START_MARKER.length);
    // 未闭合或嵌套的标记不处理，避免误删后续正文。
    const nestedStartIndex = html.indexOf(START_MARKER, startIndex + START_MARKER.length);
    if (endIndex < 0 || (nestedStartIndex >= 0 && nestedStartIndex < endIndex)) break;

    const startBlockStart = html.lastIndexOf('<p', startIndex);
    const startBlockEnd = html.indexOf('</p>', startIndex);
    const endBlockStart = html.lastIndexOf('<p', endIndex);
    const endBlockEnd = html.indexOf('</p>', endIndex);

    const removeStart = startBlockStart >= cursor ? startBlockStart : startIndex;
    const removeEnd = endBlockEnd >= 0
      ? endBlockEnd + 4
      : endIndex + END_MARKER.length;
    const dataStart = startBlockEnd >= 0 && startBlockEnd < endIndex
      ? startBlockEnd + 4
      : startIndex + START_MARKER.length;
    const dataEnd = endBlockStart >= dataStart ? endBlockStart : endIndex;

    // 边界异常时保留原文，不尝试删除不确定的内容。
    if (removeStart < cursor || removeEnd <= removeStart || dataEnd < dataStart) break;

    appendHtml(html.slice(cursor, removeStart));
    const links = parseFriendLinks(html.slice(dataStart, dataEnd));
    if (links.length > 0) parts.push({ type: 'links', links });
    cursor = removeEnd;
  }

  appendHtml(html.slice(cursor));

  return {
    content: contentParts.join(''),
    parts,
  };
}

const settings = warmSettings(options);
const extracted = extractFriendLinks(page.content);
const displayContent = extracted.parts;
---
<WarmShell
  title={page.title}
  description={plainExcerpt(extracted.content, 160)}
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  currentPageCid={page.cid}
  pageContext={{ hasComments: page.allowComment, pageType: 'page' }}
  pluginCtx={pluginCtx}
  section="none"
  detail
>
  <article class="warm-article warm-page warm-friendlinks-page" itemscope itemtype="https://schema.org/Article">
    <header class="warm-article__header warm-article__hero">
      <div class="warm-article__hero-inner">
        <div class="warm-item-meta"><span class="warm-note-label">友情链接</span></div>
        <h1 itemprop="headline">{page.title}</h1>
      </div>
    </header>

    {displayContent.length > 0 && (
      <div class="warm-prose warm-friendlinks-content" view-image itemprop="articleBody">
        {displayContent.map(part => part.type === 'html' ? (
          <Fragment set:html={optimizeContentImages(part.content, settings.imageOptimizeParams, urls.siteUrl)} />
        ) : (
          <ul class="warm-friendlinks" aria-label="友情链接">
            {part.links.map(link => (
              <li class="warm-friendlinks__item">
                <a class="warm-friendlinks__card" href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class="warm-friendlinks__name">{link.name}</span>
                  {link.description && <span class="warm-friendlinks__description">{link.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    )}
  </article>

  {(page.allowComment || commentPagination.totalComments > 0) && (
    <WarmComments
      cid={page.cid}
      componentLoadMode={settings.commentComponentLoadMode}
      initialLoadMode={settings.commentInitialLoadMode}
      cooldownSeconds={options.commentsPostIntervalEnable ? (options.commentsPostInterval || 60) : 0}
      contentType="page"
      showManagementButtons={settings.showCommentManagementButtons}
    />
  )}
</WarmShell>

<style>
  .warm-friendlinks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .warm-friendlinks__item {
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .warm-friendlinks__card {
    display: flex;
    min-height: 104px;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    box-sizing: border-box;
    padding: 18px 14px;
    border: 1px solid color-mix(in srgb, var(--warm-border, #e8e8e8) 72%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--warm-card, var(--warm-bg, #fff)) 72%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    color: inherit;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 2px 9px rgba(20, 40, 30, .035);
    transition: transform .2s ease, border-color .2s ease, background-color .2s ease, box-shadow .2s ease;
  }

  .warm-friendlinks__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--warm-accent, #269b63) 58%, transparent);
    background: color-mix(in srgb, var(--warm-card, var(--warm-bg, #fff)) 84%, transparent);
    box-shadow: 0 6px 18px rgba(20, 40, 30, .08);
  }

  .warm-friendlinks__name {
    max-width: 100%;
    color: var(--warm-text, inherit);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .warm-friendlinks__description {
    max-width: 100%;
    color: var(--warm-muted, #888);
    font-size: .82rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .warm-friendlinks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 24px;
    }

    .warm-friendlinks__card {
      min-height: 96px;
      padding: 15px 10px;
    }
  }
</style>
