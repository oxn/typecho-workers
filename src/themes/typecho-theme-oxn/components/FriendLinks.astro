---
import { and, eq } from 'drizzle-orm';
import { schema } from '@/db';
import { createContext } from '@/lib/context';
import type { ThemePageProps } from '@/lib/theme-props';
import { optimizeContentImages } from '@/lib/image-transform';
import WarmShell from './WarmShell.astro';
import WarmComments from './WarmComments.astro';
import { plainExcerpt, warmSettings } from './warm';

type Props = ThemePageProps;
const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  page, commentPagination,
} = Astro.props;

const ctx = await createContext(Astro.locals, Astro.request);
const fieldRows = await ctx.db
  .select({ value: schema.fields.str_value })
  .from(schema.fields)
  .where(and(eq(schema.fields.cid, page.cid), eq(schema.fields.name, 'links')))
  .limit(1);

type FriendLink = { name: string; url: string; description: string };
let friendLinks: FriendLink[] = [];
try {
  const parsed = JSON.parse(fieldRows[0]?.value || '[]');
  if (Array.isArray(parsed)) {
    friendLinks = parsed.flatMap((item): FriendLink[] => {
      if (!item || typeof item !== 'object') return [];
      const name = String(item.name ?? '').trim();
      const rawUrl = String(item.url ?? '').trim();
      const description = String(item.description ?? '').trim();
      if (!name || !rawUrl) return [];
      try {
        const url = new URL(rawUrl);
        if (url.protocol !== 'http:' && url.protocol !== 'https:') return [];
        return [{ name, url: url.href, description }];
      } catch {
        return [];
      }
    });
  }
} catch {
  friendLinks = [];
}

const settings = warmSettings(options);
const displayContent = optimizeContentImages(page.content, settings.imageOptimizeParams, urls.siteUrl);
---
<WarmShell
  title={page.title}
  description={plainExcerpt(page.content, 160)}
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  currentPageCid={page.cid}
  pageContext={{ hasComments: page.allowComment, pageType: 'page' }}
  pluginCtx={pluginCtx}
  section="none"
  detail
>
  <article class="warm-article warm-page warm-friend-links" itemscope itemtype="https://schema.org/Article">
    <header class="warm-article__header warm-article__hero">
      <div class="warm-article__hero-inner">
        <div class="warm-item-meta"><span class="warm-note-label">友情链接</span></div>
        <h1 itemprop="headline">{page.title}</h1>
      </div>
    </header>

    <section class="friend-links" aria-label="友情链接">
      {friendLinks.length > 0 ? (
        <ul class="friend-links__grid">
          {friendLinks.map((link) => (
            <li class="friend-links__item">
              <a class="friend-links__card" href={link.url} target="_blank" rel="noopener noreferrer">
                <span class="friend-links__name">{link.name}</span>
                {link.description && <span class="friend-links__description">{link.description}</span>}
                <span class="friend-links__url">{new URL(link.url).hostname}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="friend-links__empty">还没有添加友情链接。</p>
      )}
    </section>

    {page.content.trim() && (
      <div class="warm-prose friend-links__content" itemprop="articleBody" set:html={displayContent} />
    )}
  </article>

  {(page.allowComment || commentPagination.totalComments > 0) && (
    <WarmComments
      cid={page.cid}
      componentLoadMode={settings.commentComponentLoadMode}
      initialLoadMode={settings.commentInitialLoadMode}
      cooldownSeconds={options.commentsPostIntervalEnable ? (options.commentsPostInterval || 60) : 0}
      contentType="page"
      showManagementButtons={settings.showCommentManagementButtons}
    />
  )}
</WarmShell>

<style>
  .friend-links { margin: 8px 0 30px; }
  .friend-links__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .friend-links__item { min-width: 0; margin: 0; }
  .friend-links__card {
    display: flex;
    min-height: 94px;
    flex-direction: column;
    gap: 7px;
    padding: 16px 18px;
    border: 1px solid var(--warm-border, #e8e8e8);
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
    transition: border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .friend-links__card:hover {
    border-color: var(--warm-accent, #269b63);
    transform: translateY(-2px);
  }
  .friend-links__name { overflow-wrap: anywhere; font-size: 1rem; font-weight: 650; line-height: 1.45; }
  .friend-links__description { color: var(--warm-muted, #888); font-size: .86rem; line-height: 1.65; overflow-wrap: anywhere; }
  .friend-links__url { margin-top: auto; color: var(--warm-muted, #999); font-size: .75rem; line-height: 1.4; overflow-wrap: anywhere; }
  .friend-links__empty {
    margin: 0;
    padding: 18px;
    border: 1px dashed var(--warm-border, #e8e8e8);
    border-radius: 9px;
    color: var(--warm-muted, #888);
    text-align: center;
  }
  .friend-links__content { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--warm-border, #e8e8e8); }
  @media (max-width: 560px) {
    .friend-links__grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .friend-links__card { min-height: 82px; padding: 14px 15px; }
  }
</style>
