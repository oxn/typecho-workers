---
import Base from '@/layouts/Base.astro';
import type { ThemeBaseProps } from '@/lib/theme-props';
import type { PageContext } from '@/lib/plugin';
import { PUBLIC_HTML_HEADER } from '@/lib/cache';
import { and, eq, inArray } from 'drizzle-orm';
import { schema, type Database } from '@/db';
import { warmSettings, renderFooterCustomHtml, type WarmSection } from './warm';
import { instantClickSource } from './instantclick';
import { viewImageSource } from './viewimage';
import { octiconPath, octiconSvg, renderIconInput } from './octicons';

interface Props extends Omit<ThemeBaseProps, 'user' | 'isLoggedIn'> {
  title?: string;
  description?: string;
  section?: WarmSection;
  pageContext?: PageContext;
  detail?: boolean;
  currentPageCid?: number;
}

const {
  title,
  description,
  section = 'none',
  detail = false,
  options,
  urls,
  pages,
  sidebarData,
  pluginCtx,
  pageContext,
  currentPath,
  currentPageCid,
} = Astro.props;

Astro.response.headers.set(PUBLIC_HTML_HEADER, '1');

const settings = warmSettings(options);
const navHomeLabel = settings.navHomeLabel.trim() || '首页';
const navArticlesLabel = settings.navArticlesLabel.trim() || '文章';
const navNotesLabel = settings.navNotesLabel.trim() || '笔记';
const navHomeLabelHtml = renderIconInput(navHomeLabel, 16, { plainText: true });
const navArticlesLabelHtml = renderIconInput(navArticlesLabel, 16, { plainText: true });
const navNotesLabelHtml = renderIconInput(navNotesLabel, 16, { plainText: true });
const navPageSlugs = pages.map(page => page.slug).filter(Boolean);
const navFieldRows = navPageSlugs.length
  ? await (pluginCtx as typeof pluginCtx & { db: Database }).db
    .select({
      slug: schema.contents.slug,
      fieldName: schema.fields.name,
      fieldValue: schema.fields.str_value,
    })
    .from(schema.contents)
    .innerJoin(schema.fields, eq(schema.contents.cid, schema.fields.cid))
    .where(and(
      eq(schema.contents.type, 'page'),
      inArray(schema.contents.slug, navPageSlugs),
      inArray(schema.fields.name, ['name', 'icons']),
    ))
  : [];
const navFieldsBySlug = new Map<string, { name: string; hasName: boolean; icon: string }>();
for (const row of navFieldRows) {
  if (!row.slug) continue;
  const fields = navFieldsBySlug.get(row.slug) ?? { name: '', hasName: false, icon: '' };
  const value = typeof row.fieldValue === 'string' ? row.fieldValue.trim() : '';
  if (row.fieldName === 'name') {
    fields.hasName = true;
    fields.name = value;
  } else if (row.fieldName === 'icons') {
    fields.icon = value;
  }
  navFieldsBySlug.set(row.slug, fields);
}
const navLinkMatchesCurrentPageAlias = (href: string): boolean => {
  if (!currentPath || currentPath === '/') return false;
  try {
    const normalizeAliasPath = (value: string): string => {
      const pathname = new URL(value, urls.siteUrl).pathname;
      return pathname
        .replace(/\\/g, '/')
        .replace(/\.[^/.]+$/, '')
        .replace(/\/$/, '') || '/';
    };
    return normalizeAliasPath(href) === normalizeAliasPath(currentPath);
  } catch {
    return false;
  }
};
const navLinkMatchesCurrentPageCid = (href: string): boolean => {
  if (!Number.isSafeInteger(currentPageCid) || Number(currentPageCid) <= 0) return false;
  try {
    const pathname = new URL(href, urls.siteUrl).pathname;
    // Match a navigation URL whose path segment begins with the current CID (CID + *).
    // The numeric capture is greedy, so CID 123 will not match 1234.
    const match = pathname.match(/(?:^|\/)(\d+).*/);
    return !!match && Number(match[1]) === Number(currentPageCid);
  } catch {
    return false;
  }
};
const navPages = pages.flatMap(page => {
  const fields = navFieldsBySlug.get(page.slug);
  const iconHtml = renderIconInput(fields?.icon, 16);
  const label = fields?.hasName ? fields.name : page.title;
  if (!label && !iconHtml) return [];
  return [{ ...page, label, iconHtml, ariaLabel: label || page.title }];
});
const footerCustomHtml = renderFooterCustomHtml(settings.footerCustomHtml);
const themeToggleEnabled = settings.showThemeToggleButton;
const searchEnabled = settings.showHomeSearchButton;
const adminEntryEnabled = settings.showAdminEntryButton;
const quickActionCount = [themeToggleEnabled, searchEnabled, adminEntryEnabled].filter(Boolean).length;
const categories = sidebarData.categories.slice(0, 8);
const homeUrl = `${urls.siteUrl.replace(/\/$/, '')}/`;
const notesEnabled = pluginCtx.activatedPlugins.has('typecho-plugin-notes');
const footerLinks = [
  ...settings.footerLinks.map(link => ({
    label: link.text,
    href: link.url,
    newWindow: link.newWindow,
    iconHtml: renderIconInput(link.icon, 15),
    labelHtml: renderIconInput(link.text, 15, { plainText: true }),
  })),
  { label: 'RSS', href: urls.feedUrl, newWindow: false, iconHtml: '' },
].filter(link => link.href && (link.label || link.iconHtml));
---
<Base
  title={title}
  description={description}
  options={options}
  urls={urls}
  pageContext={pageContext}
  pluginCtx={pluginCtx}
  bodyClass="warm-theme"
>
  <a class="warm-skip-link" href="#warm-content" data-no-instant>跳至正文</a>
  <header class="warm-header">
    <div class="warm-header__inner">
      <a href={homeUrl} class="warm-brand" aria-label={`${options.title} 首页`}>
        <span class="warm-brand__title">{options.title}</span>
        {options.description && <span class="warm-brand__description">{options.description}</span>}
      </a>
      <div class="warm-header__right">
      <nav class="warm-nav" aria-label="主导航">
        <a class:list={["warm-nav__link", { "is-active": section === 'home' }]} href={homeUrl} aria-current={section === 'home' ? 'page' : undefined}><span set:html={navHomeLabelHtml}></span></a>
        <details class:list={["warm-nav__dropdown", { "is-active": section === 'articles' }]}>
          <summary>
            <span set:html={navArticlesLabelHtml}></span>
            <svg class="warm-nav__chevron" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('chevron-down')}></svg>
          </summary>
          <div class="warm-nav__menu">
            <a href={`${homeUrl}?stream=posts`}>全部文章</a>
            {categories.map(category => (<a href={category.permalink}>{category.name}</a>))}
          </div>
        </details>
        {notesEnabled && (
          <a class:list={["warm-nav__link", { "is-active": section === 'notes' }]} href={`${homeUrl}?stream=notes`} aria-current={section === 'notes' ? 'page' : undefined}><span set:html={navNotesLabelHtml}></span></a>
        )}
        {navPages.map((page) => (
          <a
            class:list={["warm-nav__link", { "is-active": (currentPath != '/' && (page.permalink.includes(currentPath) || navLinkMatchesCurrentPageAlias(page.permalink))) || navLinkMatchesCurrentPageCid(page.permalink) }]}
            href={page.permalink}
            aria-label={page.ariaLabel}
            title={page.label || undefined}
          >
            {page.iconHtml && <span class="warm-nav__icon" aria-hidden="true" set:html={page.iconHtml}></span>}
            {page.label && <span>{page.label}</span>}
          </a>
        ))}
      </nav>
      <div class="warm-header__tools" aria-label="快捷入口">
        {quickActionCount > 1 ? (
          <div class="warm-quick-menu">
            <button type="button" class="warm-search-trigger warm-quick-menu__trigger" data-warm-quick-toggle aria-label="打开更多" title="更多" aria-expanded="false">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('sidebar-expand')}></svg>
            </button>
            <div class="warm-quick-menu__items" data-warm-quick-menu hidden aria-label="快捷功能">
              {themeToggleEnabled && (
                <div class="warm-theme-control">
                  <button type="button" class="warm-search-trigger warm-theme-trigger" data-warm-theme-toggle aria-label="显示模式：跟随系统" title="显示模式：跟随系统" aria-expanded="false">
                    <svg data-warm-theme-icon-light viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" hidden set:html={octiconPath('sun')}></svg>
                    <svg data-warm-theme-icon-system viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" set:html={octiconPath('device-desktop')}></svg>
                    <svg data-warm-theme-icon-dark viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" hidden set:html={octiconPath('moon')}></svg>
                  </button>
                  <div class="warm-theme-menu" data-warm-theme-menu hidden aria-label="显示模式">
                    <button type="button" data-warm-theme-choice="light" aria-label="明亮模式" title="明亮模式" aria-pressed="false"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('sun')}></svg>
                    </button>
                    <button type="button" data-warm-theme-choice="system" aria-label="跟随系统" title="跟随系统" aria-pressed="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('device-desktop')}></svg>
                    </button>
                    <button type="button" data-warm-theme-choice="dark" aria-label="暗黑模式" title="暗黑模式" aria-pressed="false"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('moon')}></svg>
                    </button>
                  </div>
                </div>
              )}
              {searchEnabled && (
                <button type="button" class="warm-search-trigger" data-warm-search-open aria-label="打开搜索" title="全局搜索">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('search')}></svg>
                </button>
              )}
              {adminEntryEnabled && (
                <a class="warm-search-trigger warm-nav__account" href={urls.adminUrl} data-no-instant aria-label="进入后台" title="进入后台">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" set:html={octiconPath('sign-in-24')}></svg>
                </a>
              )}
            </div>
          </div>
        ) : (
          <div class="warm-quick-menu warm-quick-menu--single">
            <div class="warm-quick-menu__items">
              {themeToggleEnabled && (
                <div class="warm-theme-control">
                  <button type="button" class="warm-search-trigger warm-theme-trigger" data-warm-theme-toggle aria-label="显示模式：跟随系统" title="显示模式：跟随系统" aria-expanded="false">
                    <svg data-warm-theme-icon-light viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" hidden set:html={octiconPath('sun')}></svg>
                    <svg data-warm-theme-icon-system viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" set:html={octiconPath('device-desktop')}></svg>
                    <svg data-warm-theme-icon-dark viewBox="0 0 16 16" width="24" height="24" fill="currentColor" aria-hidden="true" hidden set:html={octiconPath('moon')}></svg>
                  </button>
                  <div class="warm-theme-menu" data-warm-theme-menu hidden aria-label="显示模式">
                    <button type="button" data-warm-theme-choice="light" aria-label="明亮模式" title="明亮模式" aria-pressed="false"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('sun')}></svg></button>
                    <button type="button" data-warm-theme-choice="system" aria-label="跟随系统" title="跟随系统" aria-pressed="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('device-desktop')}></svg></button>
                    <button type="button" data-warm-theme-choice="dark" aria-label="暗黑模式" title="暗黑模式" aria-pressed="false"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={octiconPath('moon')}></svg></button>
                  </div>
                </div>
              )}
              {searchEnabled && (
                <button type="button" class="warm-search-trigger" data-warm-search-open aria-label="打开搜索" title="全局搜索">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('search')}></svg>
                </button>
              )}
              {adminEntryEnabled && (
                <a class="warm-search-trigger warm-nav__account" href={urls.adminUrl} data-no-instant aria-label="进入后台" title="进入后台">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" set:html={octiconPath('sign-in-24')}></svg>
                </a>
              )}
            </div>
          </div>
        )}
      </div>      </div>
      </div>
  </header>

  <main id="warm-content" class:list={["warm-main", { "warm-main--detail": detail }]} tabindex="-1" data-octicon-copy={octiconSvg('copy', 16)} data-octicon-check={octiconSvg('check', 16)}>
    <slot />
  </main>

  <footer class="warm-footer">
    {footerCustomHtml.trim() && (
      <div class="warm-footer__custom" set:html={footerCustomHtml}></div>
    )}
    <div class="warm-footer__meta">
      <div class="warm-footer__copyright">
        <span>© {new Date().getFullYear()} {options.title}</span>
        {options.description && <><span aria-hidden="true">·</span><span class="warm-footer__tagline">{options.description}</span></>}
      </div>
      <nav aria-label="页脚链接">
        {footerLinks.map(link => (
          <a
            href={link.href}
            target={link.newWindow ? '_blank' : undefined}
            rel={link.newWindow ? 'noopener noreferrer' : undefined}
          >
            {link.iconHtml && <span set:html={link.iconHtml}></span>}
            {link.labelHtml && <span set:html={link.labelHtml}></span>}
          </a>
        ))}
      </nav>
    </div>
  </footer>
  {searchEnabled && (
    <dialog class="warm-search-dialog" data-warm-search-dialog aria-labelledby="warm-search-title">
      <div class="warm-search-dialog__panel">
        <button type="button" class="warm-search-dialog__close" data-warm-search-close aria-label="关闭搜索"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('x')}></svg></button>
        <h2 id="warm-search-title">搜索文章</h2>
        <form class="warm-search-form" data-warm-search-form method="get" action={homeUrl}>
          <input type="search" class="warm-search-input" data-warm-search-input name="s" placeholder="输入关键词…" autocomplete="off" aria-label="搜索关键词" />
          <button type="submit" class="warm-search-submit" aria-label="搜索">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" set:html={octiconPath('search')}></svg>
            <span>搜索</span>
          </button>
        </form>
      </div>
    </dialog>
  )}
  <script is:inline>
    (() => {
      const themeStorageKey = 'warm-theme-mode';
      const validThemeModes = ['light', 'system', 'dark'];

      // The controller lives on window because InstantClick replaces <body>
      // and re-executes this script while the document itself remains alive.
      // Keep theme state and document/media listeners stable across swaps.
      let themeController = window.__warmThemeController;
      if (!themeController) {
        const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
        let themeMode = 'system';
        try {
          const savedMode = window.localStorage.getItem(themeStorageKey);
          if (validThemeModes.includes(savedMode)) themeMode = savedMode;
        } catch {}

        const applyThemeMode = () => {
          const isDark = themeMode === 'dark' || (themeMode === 'system' && themeMedia.matches);
          document.documentElement.classList.toggle('dark', isDark);
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#171819' : '#ffffff');
          const lightIcon = document.querySelector('[data-warm-theme-icon-light]');
          const systemIcon = document.querySelector('[data-warm-theme-icon-system]');
          const darkIcon = document.querySelector('[data-warm-theme-icon-dark]');
          // Use inline display so the selected icon wins over theme-wide SVG rules.
          if (lightIcon) lightIcon.style.display = themeMode === 'light' ? 'block' : 'none';
          if (systemIcon) systemIcon.style.display = themeMode === 'system' ? 'block' : 'none';
          if (darkIcon) darkIcon.style.display = themeMode === 'dark' ? 'block' : 'none';
          const themeToggle = document.querySelector('[data-warm-theme-toggle]');
          const modeLabels = { light: '明亮模式', system: '跟随系统', dark: '暗黑模式' };
          if (themeToggle) {
            themeToggle.setAttribute('aria-label', `显示模式：${modeLabels[themeMode]}`);
            themeToggle.setAttribute('title', `显示模式：${modeLabels[themeMode]}`);
          }
          document.querySelectorAll('[data-warm-theme-choice]').forEach(option => {
            option.setAttribute('aria-pressed', option.getAttribute('data-warm-theme-choice') === themeMode ? 'true' : 'false');
          });
        };

        themeController = {
          apply: applyThemeMode,
          setMode: selectedMode => {
            if (!validThemeModes.includes(selectedMode)) return;
            themeMode = selectedMode;
            try { window.localStorage.setItem(themeStorageKey, themeMode); } catch {}
            applyThemeMode();
          },
        };
        window.__warmThemeController = themeController;

        themeMedia.addEventListener?.('change', () => {
          if (themeMode === 'system') applyThemeMode();
        });

        document.addEventListener('click', event => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target) return;

          const quickToggle = target.closest('[data-warm-quick-toggle]');
          if (quickToggle) {
            const menu = document.querySelector('[data-warm-quick-menu]');
            if (menu) {
              const opening = menu.hidden;
              menu.hidden = !opening;
              quickToggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
            }
            return;
          }

          const themeToggle = target.closest('[data-warm-theme-toggle]');
          if (themeToggle) {
            const menu = themeToggle.parentElement?.querySelector('[data-warm-theme-menu]');
            if (menu) {
              const opening = menu.hidden;
              menu.hidden = !opening;
              themeToggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
            }
            return;
          }

          const themeChoice = target.closest('[data-warm-theme-choice]');
          if (themeChoice) {
            themeController.setMode(themeChoice.getAttribute('data-warm-theme-choice'));
            const control = themeChoice.closest('.warm-theme-control');
            const menu = control?.querySelector('[data-warm-theme-menu]');
            const toggle = control?.querySelector('[data-warm-theme-toggle]');
            if (menu) menu.hidden = true;
            if (toggle) {
              toggle.setAttribute('aria-expanded', 'false');
              toggle.focus();
            }
            return;
          }

          if (!target.closest('[data-warm-theme-menu]')) {
            document.querySelectorAll('[data-warm-theme-menu]').forEach(menu => { menu.hidden = true; });
            document.querySelectorAll('[data-warm-theme-toggle]').forEach(toggle => toggle.setAttribute('aria-expanded', 'false'));
          }

          if (!target.closest('.warm-quick-menu')) {
            const quickMenu = document.querySelector('[data-warm-quick-menu]');
            const quickButton = document.querySelector('[data-warm-quick-toggle]');
            if (quickMenu) quickMenu.hidden = true;
            if (quickButton) quickButton.setAttribute('aria-expanded', 'false');
          }

          if (target.closest('[data-warm-search-open]')) {
            const quickMenu = document.querySelector('[data-warm-quick-menu]');
            const quickButton = document.querySelector('[data-warm-quick-toggle]');
            if (quickMenu) quickMenu.hidden = true;
            if (quickButton) quickButton.setAttribute('aria-expanded', 'false');
            const dialog = document.querySelector('[data-warm-search-dialog]');
            if (dialog instanceof HTMLDialogElement && !dialog.open) {
              dialog.showModal();
              dialog.querySelector('[data-warm-search-input]')?.focus();
            }
          } else if (target.closest('[data-warm-search-close]')) {
            const dialog = target.closest('[data-warm-search-dialog]');
            if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
          } else {
            const dialog = target.closest('[data-warm-search-dialog]');
            if (dialog instanceof HTMLDialogElement && target === dialog && dialog.open) dialog.close();
          }
        });

        document.addEventListener('keydown', event => {
          if (event.key !== 'Escape') return;
          const quickMenu = document.querySelector('[data-warm-quick-menu]');
          const quickButton = document.querySelector('[data-warm-quick-toggle]');
          if (quickMenu) quickMenu.hidden = true;
          if (quickButton) quickButton.setAttribute('aria-expanded', 'false');
          document.querySelectorAll('[data-warm-theme-menu]').forEach(menu => { menu.hidden = true; });
          document.querySelectorAll('[data-warm-theme-toggle]').forEach(toggle => toggle.setAttribute('aria-expanded', 'false'));
        });
      }

      // Add copy controls to block and inline code without changing rendered Markdown.
      const copyIcons = document.querySelector('#warm-content');
      const copyIcon = copyIcons?.dataset.octiconCopy || '';
      const inlineCopyIcon = copyIcon.replace('width="16" height="16"', 'width="14" height="14"');
      const copiedIcon = copyIcons?.dataset.octiconCheck || '';
      const inlineCopiedIcon = copiedIcon.replace('width="16" height="16"', 'width="14" height="14"');

      document.querySelectorAll('.warm-prose pre:not([data-warm-copy-ready])').forEach(pre => {
        pre.dataset.warmCopyReady = '1';
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.warmCopy = '';
        button.setAttribute('aria-label', '复制代码');
        button.innerHTML = copyIcon;
        pre.append(button);
      });

      document.querySelectorAll('.warm-prose code, .warm-note__content code').forEach(code => {
        if (code.closest('pre') || code.dataset.warmInlineCopyReady === '1') return;

        const anchor = code.closest('a');
        if (anchor?.dataset.warmInlineCopyReady === '1') return;

        const frame = document.createElement('span');
        frame.dataset.warmInlineCode = '';
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.warmInlineCopy = '';
        button.setAttribute('aria-label', '复制代码');
        button.innerHTML = inlineCopyIcon;

        if (anchor && anchor.contains(code)) {
          anchor.dataset.warmInlineCopyReady = '1';
          anchor.before(frame);
          frame.append(anchor, button);
          code.dataset.warmInlineCopyReady = '1';
        } else {
          code.before(frame);
          frame.append(code, button);
          code.dataset.warmInlineCopyReady = '1';
        }
      });

      if (!window.__warmCodeCopyListener) {
        window.__warmCodeCopyListener = true;
        const copyText = async (text, trigger) => {
          let copied = false;
          try {
            if (navigator.clipboard?.writeText && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
              copied = true;
            }
          } catch {}
          if (!copied) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            textarea.style.pointerEvents = 'none';
            const copyHost = trigger?.closest('dialog[open]') || document.body;
            copyHost.append(textarea);
            textarea.focus({ preventScroll: true });
            textarea.select();
            textarea.setSelectionRange(0, textarea.value.length);
            const handleCopy = event => {
              if (!event.clipboardData) return;
              event.clipboardData.setData('text/plain', text);
              event.preventDefault();
              copied = true;
            };
            textarea.addEventListener('copy', handleCopy);
            try { document.execCommand('copy'); } catch {}
            textarea.removeEventListener('copy', handleCopy);
            textarea.remove();
          }
          return copied;
        };

        document.addEventListener('click', async event => {
          const button = event.target instanceof Element
            ? event.target.closest('[data-warm-copy], [data-warm-inline-copy], [data-warm-copy-confirm]')
            : null;
          if (!button) return;

          const pre = button.closest('pre');
          const isInline = button.hasAttribute('data-warm-inline-copy');
          const isConfirm = button.hasAttribute('data-warm-copy-confirm');
          let text = '';
          if (isConfirm) {
            text = '确认';
          } else if (pre) {
            const clone = pre.cloneNode(true);
            clone.querySelector('[data-warm-copy]')?.remove();
            text = clone.textContent || '';
          } else if (isInline) {
            const code = button.closest('[data-warm-inline-code]')?.querySelector('code');
            if (!code) return;
            text = code.textContent || '';
          } else {
            return;
          }

          const originalHtml = button.innerHTML;
          const originalLabel = button.getAttribute('aria-label') || '复制代码';
          const originalTitle = button.getAttribute('title') || originalLabel;
          const copied = await copyText(text, button);
          button.dataset.copied = copied ? 'true' : 'false';
          button.setAttribute('aria-label', copied ? '复制成功' : '复制失败');
          button.title = copied ? '复制成功' : '复制失败';
          if (copied) button.innerHTML = copiedIcon;
          window.setTimeout(() => {
            if (!button.isConnected) return;
            button.dataset.copied = 'false';
            button.setAttribute('aria-label', originalLabel);
            button.title = originalTitle;
            button.innerHTML = originalHtml;
          }, 1200);
        });
      }

      // Re-apply the persistent preference to the newly swapped page's controls.
      themeController.apply();

      // Page-bound listeners and observers must not retain the previous body.
      window.__warmThemePageCleanup?.();
      const pageAbort = new AbortController();
      let headerLayoutObserver = null;
      window.__warmThemePageCleanup = () => {
        pageAbort.abort();
        headerLayoutObserver?.disconnect();
      };

      // Keep quick actions beside the navigation only when the full row fits.
      const header = document.querySelector('.warm-header');
      const headerInner = header?.querySelector('.warm-header__inner');
      const headerBrand = headerInner?.querySelector('.warm-brand');
      const headerRight = headerInner?.querySelector('.warm-header__right');
      const headerTools = headerRight?.querySelector('.warm-header__tools');
      const headerNav = headerRight?.querySelector('.warm-nav');
      const compactHeader = window.matchMedia('(max-width: 639px)');
      const updateHeaderToolsLayout = () => {
        if (!header || !headerInner || !headerBrand || !headerRight || !headerTools || !headerNav) return;
        if (compactHeader.matches) {
          header.classList.remove('warm-header--tools-inline');
          return;
        }
        const innerStyle = window.getComputedStyle(headerInner);
        const navStyle = window.getComputedStyle(headerNav);
        const innerGap = Number.parseFloat(innerStyle.columnGap) || 0;
        const rightGap = 12;
        const navGap = Number.parseFloat(navStyle.columnGap) || 0;
        const navItems = Array.from(headerNav.children);
        const navItemsWidth = navItems.reduce((total, item) => total + item.getBoundingClientRect().width, 0)
          + Math.max(0, navItems.length - 1) * navGap;
        const availableRightWidth = headerInner.clientWidth - headerBrand.getBoundingClientRect().width - innerGap;
        const requiredRightWidth = headerTools.getBoundingClientRect().width + rightGap + navItemsWidth;
        header.classList.toggle('warm-header--tools-inline', requiredRightWidth <= availableRightWidth + 1);
      };
      updateHeaderToolsLayout();
      if ('ResizeObserver' in window && headerInner) {
        headerLayoutObserver = new ResizeObserver(updateHeaderToolsLayout);
        headerLayoutObserver.observe(headerInner);
        if (headerBrand) headerLayoutObserver.observe(headerBrand);
        if (headerNav) headerLayoutObserver.observe(headerNav);
        if (headerTools) headerLayoutObserver.observe(headerTools);
      } else {
        window.addEventListener('resize', updateHeaderToolsLayout, { passive: true, signal: pageAbort.signal });
      }
      compactHeader.addEventListener?.('change', updateHeaderToolsLayout, { signal: pageAbort.signal });
      window.addEventListener('load', updateHeaderToolsLayout, { once: true, signal: pageAbort.signal });

      const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)');
      document.querySelectorAll('.warm-nav__dropdown').forEach(dropdown => {
        let openedByHover = false;
        dropdown.addEventListener('mouseenter', () => {
          if (hoverCapable.matches && !dropdown.open) {
            dropdown.open = true;
            openedByHover = true;
          }
        }, { signal: pageAbort.signal });
        dropdown.addEventListener('click', event => {
          if (!event.target.closest('summary')) return;
          // The first pointer click must not undo the preceding hover-open.
          // Keyboard activation (detail=0) keeps the native details toggle.
          if (openedByHover && event.detail > 0) event.preventDefault();
          openedByHover = false;
        }, { signal: pageAbort.signal });
        dropdown.addEventListener('mouseleave', () => {
          openedByHover = false;
          if (hoverCapable.matches && !dropdown.contains(document.activeElement)) dropdown.open = false;
        }, { signal: pageAbort.signal });
        dropdown.addEventListener('keydown', event => {
          if (event.key !== 'Escape') return;
          dropdown.open = false;
          dropdown.querySelector('summary')?.focus();
        }, { signal: pageAbort.signal });
        dropdown.addEventListener('focusout', event => {
          // iOS Safari can report a null relatedTarget while a touch tap moves
          // from <summary> to a menu link. Keep the menu until outside-click handles it.
          if (event.relatedTarget && !dropdown.contains(event.relatedTarget)) dropdown.open = false;
        }, { signal: pageAbort.signal });
      });
    })();
  </script>
  <Fragment slot="head">
    <link rel="icon" href="/themes/typecho-theme-oxn/assets/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/themes/typecho-theme-oxn/assets/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const storageKey = 'warm-theme-mode';
        const validModes = ['light', 'system', 'dark'];
        let mode = 'system';
        try {
          const savedMode = window.localStorage.getItem(storageKey);
          if (validModes.includes(savedMode)) mode = savedMode;
        } catch {}
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = mode === 'dark' || (mode === 'system' && systemPrefersDark);
        document.documentElement.classList.toggle('dark', isDark);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#171819' : '#ffffff');
      })();
    </script>
    <script is:inline data-instant-track data-no-instant set:html={instantClickSource}></script>
    <script is:inline data-instant-track data-no-instant set:html={viewImageSource}></script>
  </Fragment>
  <script is:inline data-no-instant>
    (() => {
      // Delegation also covers navigation inserted by InstantClick.
      document.addEventListener('click', event => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;
        document.querySelectorAll('.warm-nav__dropdown[open]').forEach(dropdown => {
          if (!dropdown.contains(target)) dropdown.open = false;
        });

        if (target.closest('[data-warm-search-open]')) {
          const dialog = document.querySelector('[data-warm-search-dialog]');
          if (dialog instanceof HTMLDialogElement && !dialog.open) {
            dialog.showModal();
            dialog.querySelector('[data-warm-search-input]')?.focus();
          }
        } else if (target.closest('[data-warm-search-close]')) {
          const dialog = target.closest('[data-warm-search-dialog]');
          if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
        } else {
          const dialog = target.closest('[data-warm-search-dialog]');
          if (dialog instanceof HTMLDialogElement && target === dialog && dialog.open) dialog.close();
        }
      });
      // ViewImage lightbox: click any note image to view it fullscreen.
      // init() re-registers its document-level listener idempotently, so
      // re-running it after an InstantClick page swap is safe.
      const expandNoteImages = event => {
        const button = event.target.closest('[data-warm-images-more]');
        if (!button) return;
        const grid = button.closest('.warm-note__images');
        if (!grid) return;
        grid.classList.add('is-expanded');
        button.setAttribute('aria-expanded', 'true');
        grid.querySelectorAll('[data-warm-images-rest]').forEach(item => {
          item.hidden = false;
        });
      };
      // Collect lightbox targets from image links (a wrapping an img — the
      // note-grid thumbnails) and bare content images. Plain text links must
      // keep navigating, so only `a:has(> img)` qualifies. Engines without
      // :has() fall back to collecting bare images, which keeps the lightbox
      // working and never hijacks links.
      const viewImageSelector = CSS.supports('selector(a:has(> img))')
        ? '[view-image] a:has(> img), [view-image] img:not(a img)'
        : '[view-image] img';
      if (window.ViewImage) ViewImage.init(viewImageSelector);
      document.addEventListener('click', expandNoteImages);
      const repairNoteMedia = root => {
        const scope = root && root.querySelectorAll ? root : document;
        scope.querySelectorAll('.warm-note__media video, .warm-note__media audio').forEach(media => {
          if (typeof media.load !== 'function') return;
          const reused = media.dataset.warmRepaired === '1';
          if (media.readyState === 0 || reused) {
            media.dataset.warmRepaired = '1';
            media.load();
          }
        });
      };
      window.warmRepairNoteMedia = repairNoteMedia;
      window.addEventListener('instantclick:newpage', () => repairNoteMedia(document));
      if (window.InstantClick?.supported) window.InstantClick.init('mousedown');
    })();
  </script>
