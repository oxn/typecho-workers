---
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb, schema } from 'typecho/db';
import { renderMarkdownFiltered } from '@/lib/markdown';
import type { ThemePageProps } from '@/lib/theme-props';
import { optimizeContentImages } from './warm-image';
import WarmShell from './WarmShell.astro';
import WarmComments from './WarmComments.astro';
import WarmToc from './WarmToc.astro';
import { formatWarmDate, plainExcerpt, prepareArticleToc, renderWarmIframes, warmSettings } from './warm';

type Props = ThemePageProps;
const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  page, commentPagination,
} = Astro.props;

const db = getDb(env.DB);
const settings = warmSettings(options);
const passwordLocked = page.hasPassword && !page.passwordVerified;
const rawPageSource = !passwordLocked
  ? (await db
    .select({ text: schema.contents.text })
    .from(schema.contents)
    .where(eq(schema.contents.cid, page.cid))
    .limit(1))[0]?.text || ''
  : '';
const rehypeEnabled = pluginCtx.activatedPlugins.has('typecho-plugin-markdown-rehype');
const renderedPageHtml = !passwordLocked
  ? rehypeEnabled
    ? await (await import('typecho-plugin-markdown-rehype')).renderMarkdown(rawPageSource, {
      mathEngine: settings.markdownMathEngine,
      tocEnabled: settings.markdownTocEnabled,
    })
    : await renderMarkdownFiltered(pluginCtx, rawPageSource)
  : page.content;
// Use the same Markdown renderer selection as Post. Keep the locked-page HTML
// supplied by the request pipeline untouched until the password is verified.
const pageHtml = !passwordLocked ? renderedPageHtml : page.content;
const optimizedContent = optimizeContentImages(
  pageHtml,
  settings.imageOptimizeParams,
  urls.siteUrl,
);
const toc = passwordLocked
  ? { html: optimizedContent, items: [] }
  : prepareArticleToc(optimizedContent);
const displayContent = renderWarmIframes(toc.html);
const isAbout = page.slug.toLowerCase() === 'about' || page.title === '关于';
---
<WarmShell
  title={page.title}
  description={plainExcerpt(pageHtml, 160)}
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  pageContext={{ hasComments: page.allowComment, pageType: 'page' }}
  pluginCtx={pluginCtx}
  section={isAbout ? 'about' : 'none'}
  detail
>
  <article class="warm-article warm-page" itemscope itemtype="https://schema.org/Article">
    <header class="warm-article__header warm-article__hero">
      <div class="warm-article__hero-inner">
        <div class="warm-item-meta"><span class="warm-note-label">独立页面</span><span aria-hidden="true">·</span><time>{formatWarmDate(page.created, options.postDateFormat, options.timezone)}</time></div>
        <h1 itemprop="headline">{page.title}</h1>
      </div>
    </header>
    <div class="warm-article__body" data-math-engine={!passwordLocked && rehypeEnabled ? settings.markdownMathEngine : undefined}>
      <div class="warm-prose" view-image itemprop="articleBody" set:html={displayContent} />
      {toc.items.length > 0 && <WarmToc items={toc.items} />}
    </div>
  </article>

  {(page.allowComment || commentPagination.totalComments > 0) && (
    <WarmComments
      cid={page.cid}
      componentLoadMode={settings.commentComponentLoadMode}
      initialLoadMode={settings.commentInitialLoadMode}
      cooldownSeconds={options.commentsPostIntervalEnable ? (options.commentsPostInterval || 60) : 0}
    />
  )}
</WarmShell>
