---
const { source = '', imageOptimizeParams = '', siteUrl = '' } = Astro.props as { source?: string; imageOptimizeParams?: string; siteUrl?: string };
const payload = JSON.stringify({ source, imageOptimizeParams, siteUrl }).replace(/</g, '\\u003c');
---
<div class="warm-prose" data-warm-client-content itemprop="articleBody" aria-busy="true"></div>
<script>
  import { renderInto } from '../client/markdown-renderer';

  const initialize = async () => {
    const nodes = document.querySelectorAll<HTMLElement>('[data-warm-client-content]');
    const sources = document.querySelectorAll<HTMLScriptElement>('[data-warm-client-source]');
    for (let index = 0; index < nodes.length; index += 1) {
      const node = nodes[index];
      if (node.dataset.warmClientInitialized === '1') continue;
      const sourceNode = sources[index];
      if (!sourceNode) {
        console.error('[Warm CY] client content source node is missing', { index });
        continue;
      }
      node.dataset.warmClientInitialized = '1';
      try {
        const payload = JSON.parse(sourceNode.textContent || '{}') as { source?: string; imageOptimizeParams?: string; siteUrl?: string };
        await renderInto(node, payload.source || '', {
          imageOptimizeParams: payload.imageOptimizeParams || '',
          siteUrl: payload.siteUrl || '',
        });
      } catch (error) {
        delete node.dataset.warmClientInitialized;
        console.error('[Warm CY] invalid client content payload', error);
      }
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, { once: true });
  } else {
    void initialize();
  }

  window.addEventListener('instantclick:newpage', () => void initialize());
</script>
<script type="application/json" data-warm-client-source set:html={payload}></script>
