---
const { permalink } = Astro.props as { permalink: string };
---
<div class="warm-prose warm-password-gate" role="group" aria-label="文章密码验证">
  <p>此内容已加密，请输入密码访问。</p>
  <form class="warm-password-gate__form" method="get" action={permalink}>
    <input
      class="warm-password-gate__input"
      type="password"
      name="password"
      autocomplete="current-password"
      aria-label="访问密码"
      placeholder="请输入密码"
      required
    />
    <button class="warm-password-gate__submit" type="submit">打开</button>
  </form>
</div>
