---
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';
import { getDb, schema } from 'typecho/db';
import { optimizeContentImages } from './warm-image';
import type { ThemePostProps } from '@/lib/theme-props';
import WarmShell from './WarmShell.astro';
import WarmComments from './WarmComments.astro';
import WarmNoteMedia from './WarmNoteMedia.astro';
import WarmToc from './WarmToc.astro';
import { formatWarmDate, plainExcerpt, prepareArticleToc, readingMinutes, renderArticleDeclaration, warmArticleSummary, warmSettings } from './warm';

type Props = ThemePostProps;

const {
  options, urls, pages, sidebarData, currentPath, pluginCtx,
  post, author, categories, tags, commentPagination,
} = Astro.props;

const db = getDb(env.DB);
const note = pluginCtx.activatedPlugins.has('typecho-plugin-notes')
  ? await (await import('typecho-plugin-notes')).getNoteForTheme(db, post.cid, urls.siteUrl)
  : null;
const isNote = note?.type === 'note';
const settings = warmSettings(options);
const passwordLocked = post.hasPassword && !post.passwordVerified;
const rawArticleSource = !isNote && !passwordLocked
  ? (await db
    .select({ text: schema.contents.text })
    .from(schema.contents)
    .where(eq(schema.contents.cid, post.cid))
    .limit(1))[0]?.text || ''
  : '';
// Keep published articles on the exact same Markdown renderer used by the
// editor's live preview. Do not switch parsers based on plugin activation:
// that made identical Markdown render differently between preview and frontend.
const renderedArticleHtml = !isNote && !passwordLocked
  ? await (await import('typecho-plugin-markdown-rehype')).renderMarkdown(rawArticleSource, {
    mathEngine: settings.markdownMathEngine,
    tocEnabled: settings.markdownTocEnabled,
  })
  : post.content;
const articleHtml = !isNote && !passwordLocked ? renderedArticleHtml : post.content;
const optimizedContent = optimizeContentImages(
  isNote ? note.html : articleHtml,
  settings.imageOptimizeParams,
  urls.siteUrl,
);
const toc = isNote || passwordLocked
  ? { html: optimizedContent, items: [] }
  : prepareArticleToc(optimizedContent);
const displayContent = toc.html;
const tocItems = toc.items;
const intelligenceSummary = !isNote && pluginCtx.activatedPlugins.has('typecho-plugin-intelligence')
  ? await (await import('typecho-plugin-intelligence')).readSummary(db, post.cid)
  : null;
const summary = isNote ? '' : warmArticleSummary(post, intelligenceSummary);
const description = isNote
  ? plainExcerpt(note.source, 160)
  : (summary || (!passwordLocked ? plainExcerpt(articleHtml, 160) : ''));
const articleDeclarationHtml = !isNote
  ? renderArticleDeclaration(settings.articleDeclarationHtml, {
    siteName: options.title,
    siteUrl: urls.siteUrl,
    siteDescription: options.description || '',
    postTitle: post.title,
    postUrl: post.permalink,
  })
  : '';
---
<WarmShell
  title={isNote ? '笔记' : post.title}
  description={description}
  options={options}
  urls={urls}
  pages={pages}
  sidebarData={sidebarData}
  currentPath={currentPath}
  pageContext={{ hasComments: post.allowComment, pageType: 'post' }}
  pluginCtx={pluginCtx}
  section={isNote ? 'notes' : 'articles'}
  detail={!isNote}
>
  <article class:list={["warm-article", { "is-note": isNote, "has-toc": tocItems.length > 0 }]} itemscope itemtype="https://schema.org/BlogPosting">
    <header class:list={["warm-article__header", { "warm-article__hero": !isNote }]}>
      <div class:list={{ "warm-article__hero-inner": !isNote }}>
        <div class="warm-item-meta">
          {isNote ? (
            <span class="warm-note-label">笔记</span>
          ) : categories[0] ? (
            <a class="warm-category" href={categories[0].permalink}>{categories[0].name}</a>
          ) : (
            <span>文章</span>
          )}
          <span aria-hidden="true">·</span>
          <time datetime={new Date(post.created * 1000).toISOString()} itemprop="datePublished">{formatWarmDate(post.created, options.postDateFormat, options.timezone, isNote)}</time>
          {!isNote && <><span aria-hidden="true">·</span><span>约 {readingMinutes(articleHtml)} 分钟阅读</span></>}
        </div>
        {!isNote && <h1 itemprop="headline">{post.title}</h1>}
        {summary && <p class="warm-article__summary">{summary}</p>}
      </div>
    </header>

    <div class:list={["warm-article__body", { "warm-article__body--toc": tocItems.length > 0 }]} data-math-engine={!isNote && !passwordLocked ? settings.markdownMathEngine : undefined}>
      <div class:list={["warm-prose", { "warm-note-prose": isNote }]} view-image itemprop="articleBody" set:html={displayContent} />
      {tocItems.length > 0 && <WarmToc items={tocItems} />}
    </div>

    {isNote && (
      <WarmNoteMedia
        note={note}
        detail
        optimizeParams={settings.imageOptimizeParams}
        thumbParams={settings.thumbOptimizeParams}
        siteUrl={urls.siteUrl}
      />
    )}

    {!isNote && (
      <footer class="warm-article__footer">
        {tags.length > 0 && (
          <div class="warm-article__tags">
            {tags.map(tag => <a href={tag.permalink}>#{tag.name}</a>)}
          </div>
        )}
      </footer>
    )}
  </article>

  {articleDeclarationHtml.trim() && (
    <div class="warm-article__declaration" set:html={articleDeclarationHtml}></div>
  )}

  {(post.allowComment || commentPagination.totalComments > 0) && (
    <WarmComments
      cid={post.cid}
      componentLoadMode={settings.commentComponentLoadMode}
      initialLoadMode={settings.commentInitialLoadMode}
      cooldownSeconds={options.commentsPostIntervalEnable ? (options.commentsPostInterval || 60) : 0}
    />
  )}

</WarmShell>
