{
  "name": "typecho-plugin-markdown-rehype",
  "version": "1.0.0",
  "description": "Rin Markdown article and page renderer with GFM, Mermaid, KaTeX, Refractor highlighting, image placeholders and lightbox.",
  "author": "怸歪",
  "homepage": "https://347777.xyz",
  "main": "index.ts",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "typecho",
    "plugin",
    "markdown",
    "rehype"
  ],
  "exports": {
    ".": "./index.ts",
    "./index.ts": "./index.ts",
    "./mermaid-config": "./mermaid-config.ts"
  },
  "files": [
    "index.ts",
    "mermaid-config.ts",
    "client/",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "typecho": {
    "plugin": {
      "id": "typecho-plugin-markdown-rehype",
      "name": "Markdown Rehype",
      "description": "Rin Markdown article and page renderer with GFM, Mermaid, KaTeX, Refractor highlighting, image placeholders and lightbox.",
      "version": "2026.11.13.21.10",
      "author": "怸歪",
      "authorUrl": "https://347777.xyz",
      "homepage": "https://347777.xyz",
      "license": "MIT",
      "tags": [
        "markdown",
        "rehype"
      ],
      "config": {
        "tocEnabled": {
          "type": "checkbox",
          "label": "启用 Rehype 目录生成",
          "description": "暂时保留设置界面。当前文章渲染固定按 Rin 的处理规则运行，不读取此选项；完整复刻完成后再接入设置功能。",
          "default": false
        }
      }
    }
  },
  "dependencies": {
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "rehype-raw": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "katex": "^0.16.22",
    "mermaid": "11.12.2",
    "remark-breaks": "^4.0.0",
    "refractor": "^5.0.0"
  }
}
