---
import Admin from '@/layouts/Admin.astro';
import { createContext, requireAuth } from '@/lib/context';
import { hasPermission, requireAdminCSRF } from '@/lib/auth';
import { createAdminNoticeRedirectHeaders } from '@/lib/flash';
import {
  getActiveTheme,
  getThemeConfigDefinition,
  loadThemeConfig,
  parseThemeConfigFormData,
  themeHasConfig,
} from '@/lib/theme';
import type { PluginConfigField } from '@/lib/plugin';

const ctx = await createContext(Astro.locals, Astro.request);
const authCheck = requireAuth(ctx);
if (authCheck) return authCheck;

if (!hasPermission(ctx.user!.group || 'visitor', 'administrator')) {
  return new Response('Forbidden', { status: 403 });
}

const { options, urls, user, csrfToken } = ctx;
const themeId = String(options.theme || 'typecho-theme-warm');
const theme = getActiveTheme(themeId);
const isOxnTheme = theme.packageName === 'typecho-theme-oxn';
const configDef = getThemeConfigDefinition(theme.id);

if (!themeHasConfig(theme.id) || !configDef) {
  return Astro.redirect('/admin/themes');
}

const configValues = loadThemeConfig(options, theme.id);
let message = '';
let messageType: 'success' | 'error' = 'success';

if (Astro.request.method === 'POST') {
  const csrfError = await requireAdminCSRF(Astro.request, options.secret as string, user!.authCode!, user!.uid);
  if (csrfError) return csrfError;

  try {
    const formData = await Astro.request.formData();
    const settings = parseThemeConfigFormData(configDef, formData);
    const sanitized: Record<string, unknown> = {};
    for (const key of Object.keys(configDef)) {
      sanitized[key] = settings[key];
    }

    const { setOption } = await import('@/lib/options');
    await setOption(ctx.db, `theme:${theme.id}`, JSON.stringify(sanitized));
    return new Response(null, {
      status: 302,
      headers: createAdminNoticeRedirectHeaders(
        '/admin/options-theme',
        '外观设置已经保存',
        'success',
        '/',
        Astro.request,
      ),
    });
  } catch (error) {
    message = error instanceof Error ? error.message : '保存失败';
    messageType = 'error';
  }
}

function fieldValue(value: unknown): string {
  return value == null ? '' : String(value);
}

function optionValue(value: unknown): string {
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  return String(value ?? '');
}

function selected(actual: unknown, expected: string): true | undefined {
  return optionValue(actual) === expected ? true : undefined;
}

function isChecked(value: unknown, expected: string): boolean {
  return Array.isArray(value) ? value.map(String).includes(expected) : optionValue(value) === expected;
}

function optionsFor(field: PluginConfigField): Record<string, string> {
  return field.options || {};
}

function optionId(key: string, value: string): string {
  const filtered = value.match(/[_0-9a-z-]+/gi)?.join('-') || '';
  return `${key}-${filtered}`;
}
---
<Admin title="设置外观" options={options} urls={urls} user={user} activeMenu="themes" pluginCtx={ctx}>
  <Fragment slot="before-main">
    <ul class="typecho-option-tabs fix-tabs">
      <li><a href="/admin/themes">可以使用的外观</a></li>
      <li class="current"><a href="/admin/options-theme">设置外观</a></li>
    </ul>
  </Fragment>
  <div class="col-mb-12 col-tb-8 col-tb-offset-2" role="form">
    {message && (
      <div class={`notice typecho-dismissible ${messageType === 'error' ? 'notice-error' : ''}`}>
        <p>{message}</p>
        <button type="button" class="typecho-notice-close" aria-label="关闭提示">&times;</button>
      </div>
    )}

    <form method="post" action="/admin/options-theme">
      <input type="hidden" name="_" value={csrfToken} />
      {Object.entries(configDef).map(([key, field]: [string, PluginConfigField], index) => {
        const value = configValues[key] ?? field.default ?? '';
        const id = `${key}-0-${index + 1}`;
        const isBoolean = field.type === 'checkbox' && !field.options;
        const labelFor = field.type === 'checkbox' || field.type === 'radio' ? undefined : id;

        if (field.type === 'hidden') {
          return (
            <ul class="typecho-option" id={`typecho-option-item-${key}-${index}`} style="display:none">
              <li><input type="hidden" id={id} name={key} value={fieldValue(value)} /></li>
            </ul>
          );
        }

        return (
          <ul class="typecho-option" id={`typecho-option-item-${key}-${index}`}>
            <li>
              {!isBoolean && <label class="typecho-label" for={labelFor}>{field.label}</label>}

              {field.type === 'text' && <input id={id} name={key} type="text" class="text" value={fieldValue(value)} />}
              {field.type === 'password' && <input id={id} name={key} type="password" class="text" value={fieldValue(value)} />}
              {field.type === 'textarea' && <textarea id={id} name={key}>{fieldValue(value)}</textarea>}
              {field.type === 'select' && (
                <select id={id} name={key}>
                  {Object.entries(optionsFor(field)).map(([option, label]) => (
                    <option value={option} selected={selected(value, option)}>{label}</option>
                  ))}
                </select>
              )}
              {field.type === 'radio' && (
                Object.entries(optionsFor(field)).map(([option, label]) => {
                  const inputId = optionId(key, option);
                  return (
                    <span class:list={{ multiline: field.multiline }}>
                      <input type="radio" id={inputId} name={key} value={option} checked={optionValue(value) === option} />
                      <label for={inputId}>{label}</label>
                    </span>
                  );
                })
              )}
              {isBoolean && (
                <label class="typecho-label" for={id}>
                  <input type="checkbox" id={id} name={key} value="1" checked={value === true || value === '1'} />
                  {' '}{field.label}
                </label>
              )}
              {field.type === 'checkbox' && field.options && (
                Object.entries(optionsFor(field)).map(([option, label]) => {
                  const inputId = optionId(key, option);
                  return (
                    <span class:list={{ multiline: field.multiline }}>
                      <input type="checkbox" id={inputId} name={`${key}[]`} value={option} checked={isChecked(value, option)} />
                      <label for={inputId}>{label}</label>
                    </span>
                  );
                })
              )}
              {field.description && <p class="description" set:html={field.description}></p>}
            </li>
          </ul>
        );
      })}
      <ul class="typecho-option typecho-option-submit" id={`typecho-option-item--${Object.keys(configDef).length}`}>
        <li class="oxn-settings-actions">
          <button type="submit" class="btn primary">保存设置</button>
          {isOxnTheme && (
            <div class="oxn-settings-tools">
              <button type="button" class="btn primary" id="oxn-export-settings">
                <svg class="oxn-settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12m-4-4 4 4 4-4" />
                  <path d="M5 17v3h14v-3" />
                </svg>
                导出设置
              </button>
              <button type="button" class="btn primary" id="oxn-import-settings">
                <svg class="oxn-settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 15V3m-4 4 4-4 4 4" />
                  <path d="M5 17v3h14v-3" />
                </svg>
                导入设置
              </button>
              <input type="file" id="oxn-import-file" accept="application/json,.json" hidden />
            </div>
          )}
        </li>
      </ul>
    </form>
  </div>
<script>
  const exportButton = document.getElementById('oxn-export-settings');
  const importButton = document.getElementById('oxn-import-settings');
  const importFile = document.getElementById('oxn-import-file');
  const csrfToken = document.querySelector<HTMLInputElement>('input[name="_"]')?.value || '';

  exportButton?.addEventListener('click', async () => {
    try {
      const response = await fetch('/api/admin/theme-config');
      if (!response.ok) throw new Error('读取主题设置失败');
      const data = await response.json();
      if (data.theme !== 'typecho-theme-oxn') throw new Error('当前主题不是 OXN');
      const backup = {
        format: 'oxn-theme-config',
        version: 1,
        sourceTheme: data.theme,
        settings: data.values,
      };
      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'oxn-theme-settings.json';
      link.click();
      URL.revokeObjectURL(url);
    } catch (error) {
      alert(error instanceof Error ? error.message : '导出设置失败');
    }
  });

  importButton?.addEventListener('click', () => importFile?.click());

  importFile?.addEventListener('change', async () => {
    const file = importFile.files?.[0];
    if (!file) return;
    try {
      const backup = JSON.parse(await file.text());
      const isCurrentBackup =
        backup?.format === 'oxn-theme-config' &&
        backup?.version === 1 &&
        typeof backup?.sourceTheme === 'string' &&
        backup.sourceTheme.length > 0;
      const isLegacyBackup =
        backup?.format === 'oxn-theme-settings' &&
        backup?.version === 1 &&
        backup?.theme === 'typecho-theme-oxn';
      if (
        (!isCurrentBackup && !isLegacyBackup) ||
        !backup?.settings ||
        typeof backup.settings !== 'object' ||
        Array.isArray(backup.settings)
      ) {
        throw new Error('文件格式不正确，无法识别主题设置备份');
      }
      if (!confirm('导入设置将覆盖当前 OXN 主题中对应的设置项，是否继续？')) return;
      const response = await fetch('/api/admin/theme-config', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
        },
        body: JSON.stringify({ settings: backup.settings }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || '导入设置失败');
      alert('OXN 主题设置导入成功');
      window.location.reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : '导入设置失败');
    } finally {
      importFile.value = '';
    }
  });
</script>

<style>
  .oxn-settings-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .oxn-settings-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .oxn-settings-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    color: #999;
    vertical-align: -3px;
  }

  @media (max-width: 480px) {
    .oxn-settings-tools {
      margin-left: 0;
    }
  }
</style>
</Admin>
